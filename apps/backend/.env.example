# Connection pooler de Supabase (Supavisor, puerto 6543) — NO la conexion directa (5432).
# Dashboard de Supabase -> Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxx-us-east-1.pooler.supabase.com:6543/postgres

# Dashboard de Supabase -> Project Settings -> API -> JWT Keys (firma asimetrica ES256)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Puerto del backend (opcional, default 3001 si no se setea)
PORT=3001
